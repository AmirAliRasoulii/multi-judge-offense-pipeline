# Copy to .env. Never commit .env. Environment variables override this file.
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
PROMPT_FILE=prompts/classifier.md
REVIEW_POLICY_FILE=config/review_policy.json
MAX_WORKERS=4
REQUEST_TIMEOUT=120
MAX_RETRIES=2
REQUESTS_PER_MINUTE=0
# 0 = unlimited; includes retries, per invocation. --limit limits input rows.
MAX_API_CALLS=0
# Moderation model for breaking 2-2 judge ties (e.g. omni-moderation-latest, text-moderation-latest; leave empty to disable)
MODERATION_MODEL=omni-moderation-latest

# Network routing mode: direct (default, bypasses TUN/VPN for domestic AvalAI), proxy, or system
NETWORK_MODE=direct
# Optional: proxy URL when NETWORK_MODE=proxy (supports socks5:// and http://, e.g. socks5://127.0.0.1:10808)
PROXY_URL=
# Optional: manual local IP for direct physical interface binding (auto-detected if empty)
BIND_IP=

# Four DIFFERENT model IDs; discover them with: python -m avalai_offense models
# Prefer different model families/providers after a small human-labeled pilot.
MODEL_1=
MODEL_2=
MODEL_3=
MODEL_4=

# Each slot can use chat or responses. Check AvalAI support for the selected ID.
MODEL_1_API=chat
MODEL_2_API=chat
MODEL_3_API=chat
MODEL_4_API=chat
# reasoning_json = short explanation BEFORE FINAL_JSON; other modes put reason in JSON.
# Allowed: reasoning_json, json_object, json_schema (only if supported by model/route).
MODEL_1_OUTPUT_MODE=reasoning_json
MODEL_2_OUTPUT_MODE=reasoning_json
MODEL_3_OUTPUT_MODE=reasoning_json
MODEL_4_OUTPUT_MODE=reasoning_json
# Includes internal reasoning tokens for reasoning models; raise if truncated.
MODEL_1_MAX_TOKENS=4096
MODEL_2_MAX_TOKENS=4096
MODEL_3_MAX_TOKENS=4096
MODEL_4_MAX_TOKENS=4096
# chat token field: max_completion_tokens or max_tokens; responses ignores this field.
MODEL_1_TOKEN_FIELD=max_completion_tokens
MODEL_2_TOKEN_FIELD=max_completion_tokens
MODEL_3_TOKEN_FIELD=max_completion_tokens
MODEL_4_TOKEN_FIELD=max_completion_tokens
# Leave empty unless supported. Chat maps to reasoning_effort; responses to reasoning.effort.
MODEL_1_REASONING_EFFORT=
MODEL_2_REASONING_EFFORT=
MODEL_3_REASONING_EFFORT=
MODEL_4_REASONING_EFFORT=
# Optional provider parameters as JSON. No credentials, model, messages, stream overrides.
MODEL_1_EXTRA_JSON={}
MODEL_2_EXTRA_JSON={}
MODEL_3_EXTRA_JSON={}
MODEL_4_EXTRA_JSON={}
